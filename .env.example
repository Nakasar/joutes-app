# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/joutes

# Vercel Blob Storage (pour l'upload d'images)
# En développement local, vous pouvez utiliser un token de test
# En production sur Vercel, cette variable est automatiquement configurée
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Configuration du thème
# Décommenter la ligne suivante pour activer le thème hivernal
# NEXT_PUBLIC_THEME=winter
# Pour revenir au thème par défaut, commenter la ligne ou utiliser :
NEXT_PUBLIC_THEME=default

# MEILISEARCH
MEILISEARCH_ENDPOINT=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# OPENAI (deck-checker AI import, premium AI card scanner)
OPENAI_API_KEY="TO DEFINE"

# DISCORD
DISCORD_TOKEN="TO DEFINE"
DISCORD_CLIENT_ID="TO DEFINE"
DISCORD_CLIENT_SECRET="TO DEFINE"
AI_ALLOWED_DISCORD_IDS="[]"
DISCORD_PUBLIC_KEY="TO DEFINE"

# BREIGN
BREIGN_ENDPOINT=https://api.breign.eu
BREIGN_API_KEY="TO DEFINE"

# NOTIFICATIONS PUSH
# Interrupteur général : toute la mécanique peut être déployée sans qu'un seul
# message ne parte. Seule la valeur "1" ouvre les vannes.
PUSH_ENABLED=0
# APNs (iOS) — clé .p8 du portail Apple Developer, distincte de la clé
# App Store Connect utilisée par la CI mobile. Les retours à la ligne de la clé
# peuvent être échappés en \n : ils sont rétablis à la lecture.
APNS_KEY_ID="TO DEFINE"
APNS_TEAM_ID="TO DEFINE"
APNS_PRIVATE_KEY="TO DEFINE"
APNS_BUNDLE_ID=app.joutes.mobile
# FCM (Android) — compte de service du projet Firebase.
FCM_PROJECT_ID="TO DEFINE"
FCM_CLIENT_EMAIL="TO DEFINE"
FCM_PRIVATE_KEY="TO DEFINE"
