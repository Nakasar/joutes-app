# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/joutes

# Vercel Blob Storage (pour l'upload d'images)
# En développement local, vous pouvez utiliser un token de test
# En production sur Vercel, cette variable est automatiquement configurée
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Configuration du thème
# Décommenter la ligne suivante pour activer le thème hivernal
# NEXT_PUBLIC_THEME=winter
# Pour revenir au thème par défaut, commenter la ligne ou utiliser :
NEXT_PUBLIC_THEME=default

# MEILISEARCH
MEILISEARCH_ENDPOINT=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# OPENAI (deck-checker AI import, premium AI card scanner)
OPENAI_API_KEY="TO DEFINE"

# DISCORD
DISCORD_TOKEN="TO DEFINE"
DISCORD_CLIENT_ID="TO DEFINE"
DISCORD_CLIENT_SECRET="TO DEFINE"
AI_ALLOWED_DISCORD_IDS="[]"
DISCORD_PUBLIC_KEY="TO DEFINE"

# BREIGN
BREIGN_ENDPOINT=https://api.breign.eu
BREIGN_API_KEY="TO DEFINE"

# PATREON / ABONNEMENTS
# Rien de tout ceci n'est obligatoire : sans identifiant ni secret client, la
# liaison s'affiche désactivée, le webhook répond 503 et le cron ne fait rien.
# Le site fonctionne, l'abonnement dort.
PATREON_CLIENT_ID="TO DEFINE"
PATREON_CLIENT_SECRET="TO DEFINE"
# Secret du webhook, tel que Patreon l'affiche sur la page du webhook.
PATREON_WEBHOOK_SECRET="TO DEFINE"
# Campagne et jeton du créateur : utiles seulement à la réconciliation, qui se
# dégrade proprement sans eux. Lier un compte fonctionne sans.
PATREON_CAMPAIGN_ID="TO DEFINE"
PATREON_CREATOR_ACCESS_TOKEN="TO DEFINE"
# Identifiants des paliers ouvrant chaque offre, séparés par des virgules —
# plusieurs paliers peuvent ouvrir la même (mensuel et annuel, ancien palier
# conservé). Laissés vides, le seuil de montant ci-dessous prend le relais.
#
# À renseigner dès que possible : sur Patreon un mécène est sur UN palier, et le
# mapping par identifiant lui ouvre donc exactement l'offre choisie. Le repli par
# montant, lui, franchit tous les seuils inférieurs — un abonné Pro y obtient
# aussi Expert et Supporter, ce qui n'est pas ce qu'on vend.
PATREON_TIER_SUPPORTER=
PATREON_TIER_EXPERT=
PATREON_TIER_PRO=
PATREON_MIN_CENTS_SUPPORTER=100
PATREON_MIN_CENTS_EXPERT=500
PATREON_MIN_CENTS_PRO=1900
# Développement et aperçus uniquement : force ces offres pour tout compte
# connecté, afin de montrer les écrans sans campagne. Ignoré en production.
PATREON_DEV_FORCE_PLAN=
# Adresse publique de la page Patreon. Non définie, l'appel à l'action de la
# page d'offres devient « bientôt disponible ».
NEXT_PUBLIC_PATREON_URL=https://www.patreon.com/joutes

# DIRECTS TWITCH / YOUTUBE
# Rien de tout ceci n'est obligatoire : sans identifiant ni secret client, la
# liaison s'affiche désactivée sur « Connexions et comptes » et le bouton de
# connexion correspondant disparaît de la page de login. Sans secret d'écoute,
# la liaison fonctionne mais l'annonce automatique des directs dort — les
# webhooks répondent 503 et le cron ne fait rien.
#
# Twitch : une application sur https://dev.twitch.tv/console/apps, avec
# l'adresse de redirection OAuth <BASE_URL>/api/auth/callback/twitch.
TWITCH_CLIENT_ID="TO DEFINE"
TWITCH_CLIENT_SECRET="TO DEFINE"
# Le secret dont Twitch signera ses livraisons EventSub. Nous le choisissons —
# il est transmis à la création de chaque abonnement. Entre 10 et 100
# caractères, borne imposée par Twitch. À générer au hasard, par exemple
# `openssl rand -hex 32`.
TWITCH_EVENTSUB_SECRET="TO DEFINE"
#
# YouTube : une chaîne appartient à un compte Google, et c'est ce compte que
# l'on lie. Identifiants OAuth depuis https://console.cloud.google.com, avec
# l'adresse de redirection <BASE_URL>/api/auth/callback/google. L'écran de
# compte ne parle jamais de Google, seulement de la chaîne.
GOOGLE_CLIENT_ID="TO DEFINE"
GOOGLE_CLIENT_SECRET="TO DEFINE"
# Clé de l'API YouTube Data v3, du même projet. Elle sert à une seule question,
# posée à `videos.list` : « cette vidéo est-elle en direct ? ». Une unité de
# quota par lot de cinquante identifiants.
YOUTUBE_API_KEY="TO DEFINE"
# Le secret du hub WebSub. Facultatif dans la spécification, obligatoire ici :
# sans lui, l'adresse du webhook suffirait à déclarer un faux direct.
YOUTUBE_WEBSUB_SECRET="TO DEFINE"

# NOTIFICATIONS PUSH
# Interrupteur général : toute la mécanique peut être déployée sans qu'un seul
# message ne parte. Seule la valeur "1" ouvre les vannes.
PUSH_ENABLED=0
# APNs (iOS) — clé .p8 du portail Apple Developer, distincte de la clé
# App Store Connect utilisée par la CI mobile. Les retours à la ligne de la clé
# peuvent être échappés en \n : ils sont rétablis à la lecture.
APNS_KEY_ID="TO DEFINE"
APNS_TEAM_ID="TO DEFINE"
APNS_PRIVATE_KEY="TO DEFINE"
APNS_BUNDLE_ID=app.joutes.mobile
# FCM (Android) — compte de service du projet Firebase.
FCM_PROJECT_ID="TO DEFINE"
FCM_CLIENT_EMAIL="TO DEFINE"
FCM_PRIVATE_KEY="TO DEFINE"
